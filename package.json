{
  "name": "@via-vitae/web",
  "version": "0.1.0",
  "private": true,
  "description": "ViaVitae public marketing and product website \u2014 Next.js 15 App Router, React 19, next-intl (LT/EN/RU), MDX content, generated cross-repo API contracts.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "generate:types": "openapi-typescript docs/contracts/assessment.openapi.yaml -o src/generated/assessment.ts && openapi-typescript docs/contracts/quotes.openapi.yaml -o src/generated/quotes.ts",
    "prebuild": "pnpm run generate:types",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --dir tests/contract",
    "test:a11y": "playwright test --grep @a11y",
    "test:e2e": "playwright test",
    "check:i18n": "tsx scripts/check-i18n-parity.ts",
    "check:seo": "tsx scripts/check-seo-matrix.ts",
    "check:generated": "tsx scripts/check-generated-fresh.ts",
    "check:headers": "node scripts/check-header-split.mjs",
    "verify": "pnpm run check:generated && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:i18n && pnpm run check:seo && pnpm run check:headers",
    "lighthouse": "lhci autorun --config=lighthouse/lighthouserc.json"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@via-vitae/brand": "workspace:*",
    "gray-matter": "^4.0.3",
    "next": "^15.1.0",
    "next-intl": "^4.14.2",
    "next-mdx-remote": "^5.0.0",
    "openapi-fetch": "^0.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.2.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.0",
    "yaml": "^2.6.0"
  }
}
