{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready|Local:|started server on",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://127.0.0.1:3000/en",
        "http://127.0.0.1:3000/lt",
        "http://127.0.0.1:3000/en/pricing",
        "http://127.0.0.1:3000/en/contact-support",
        "http://127.0.0.1:3000/en/resources/blog"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "budgetPath": "lighthouse/budgets.json",
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lhci"
    }
  }
}
