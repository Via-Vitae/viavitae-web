# viavitae-web environment template.
# Copy to `.env.local` (git-ignored) and fill in values. NEVER commit real values.
# QODER.md rule 7 (Secrets): this file documents variables and holds no values.
#
# Prefix rules:
#   NEXT_PUBLIC_*  -> inlined into the browser bundle at build time. Only put data
#                     here that is safe to expose publicly (it appears in CSP too).
#   (no prefix)    -> server-only. Never reachable from the client bundle.

# --- Site --------------------------------------------------------------------
# Canonical origin of this site, no trailing slash. Used for canonical URLs,
# sitemap, robots, JSON-LD and the CSP connect-src.
NEXT_PUBLIC_SITE_URL=

# Runtime bind address for the standalone server (Docker). Leave defaults local.
PORT=
HOSTNAME=
NODE_ENV=
LOG_LEVEL=

# --- viavitae-api (server-side proxies in app/api/*) -------------------------
# Public base of the assessment/quotes API. Appears in CSP connect-src, so it is
# NEXT_PUBLIC. The path is /v1 (see docs/contracts/*.openapi.yaml servers).
NEXT_PUBLIC_API_URL=
# Server-only credential the proxy presents to viavitae-api (service-to-service).
# Secret. Injected from the platform secret store; never committed.
API_SERVICE_TOKEN=
# Rate limiting for POST /api/assessment (per IP within window).
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# --- Demo embeds (components/church/demo-embed.tsx) --------------------------
# Origin framed by demo-embed.tsx; allowed by CSP frame-src.
NEXT_PUBLIC_DEMO_URL=

# --- Public contact channels (lib/constants.ts) ------------------------------
# Shown on contact-support and in the footer. A channel with no value is hidden.
# The security disclosure address is fixed by SECURITY.md and is not configurable.
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=

# --- Analytics: Matomo (self-hosted, EEA) ------------------------------------
# QODER.md rule 7 (EU data residency): the Matomo instance MUST be hosted in the
# EEA. Loaded only after granular cookie consent (lib/analytics.ts).
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=

# --- Client portal SSO: Keycloak (app/[locale]/login) ------------------------
# Server-only. The login page is a redirect-only server component; the realm URL
# and client id are not secrets but are kept server-side to avoid bundling.
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_REDIRECT_URI=

# --- Content / ISR -----------------------------------------------------------
# Server-only secret used to revalidate on-demand cached MDX content.
CONTENT_REVALIDATE_SECRET=

# --- Private package registry (@via-vitae/brand) ------------------------------
# Not an app runtime variable. pnpm reads NODE_AUTH_TOKEN + .npmrc at install
# time to pull @via-vitae/brand from GitHub Packages. Provided by CI, never
# committed. See README "Private registry" and the Dockerfile build secret.
NODE_AUTH_TOKEN=
